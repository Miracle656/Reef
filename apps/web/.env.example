# ReeF web (Next.js) — environment.
# Copy to `.env.local` for local dev; set the SAME keys in the Vercel project
# (Project → Settings → Environment Variables). Every NEXT_PUBLIC_* var is
# exposed to the browser — never put a private/secret key in one. The only
# secrets this app uses are the server-side cash-out ones at the bottom.
# One switch decides what the app is: NEXT_PUBLIC_SUI_NETWORK.

# ---- Sui network ----
#   testnet  the full app (feed, trade, predict, messages, …) on test money
#   mainnet  the wallet alone. Every testnet feature is hidden and its pages
#            redirect to /wallet. First enable Mainnet for the Enoki PUBLIC key
#            in the Enoki portal, or nobody can sign in.
NEXT_PUBLIC_SUI_NETWORK=testnet

# ---- Wallet on testnet (optional) ----
# On mainnet the wallet is always on. On testnet, set this to also show the
# wallet at /wallet next to the social app, with free test USDC
# (https://faucet.circle.com, Sui Testnet). USDC and USDSUI are sent with Sui's
# gasless stablecoin transfers, so users need no SUI and there is no sponsor.
# NEXT_PUBLIC_WALLET_NETWORK=testnet

# ---- Published Move package (packages/move/deployments/testnet.json) ----
NEXT_PUBLIC_UMBRA_PACKAGE_ID=0x0
NEXT_PUBLIC_UMBRA_REGISTRY_ID=0x0

# ---- Enoki zkLogin (PUBLIC key only) + Google OAuth client ----
# The PRIVATE Enoki key lives on the indexer/sponsor service, never here.
# Add your Vercel domain to the Enoki allowed origins and the Google OAuth
# "Authorized JavaScript origins" or sign-in will be rejected.
NEXT_PUBLIC_ENOKI_PUBLIC_API_KEY=enoki_public_xxx
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ---- Deployed indexer (tRPC API + Enoki sponsor + image/DeepBook proxies) ----
# Local dev default is http://localhost:3001. In production point these at the
# indexer service you deploy separately (Railway / Render / Fly — see DEPLOY.md).
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
NEXT_PUBLIC_SPONSOR_API_URL=http://localhost:3001/sponsor
# "enoki" (default) or "self" (indexer's self-run sponsor, needs SPONSOR_SECRET_KEY there)
NEXT_PUBLIC_SPONSOR_MODE=enoki
# #10 passkey recovery UI (Settings + post-onboarding step). Keep OFF until a real
# Google account has been checked on the production URL, see docs/passkey-recovery.md.
NEXT_PUBLIC_PASSKEY_RECOVERY=0
# WebAuthn RP ID passkeys are bound to (#9). Defaults to the current host.
NEXT_PUBLIC_PASSKEY_RP_ID=reef-web-one.vercel.app

# ---- Messaging relayer (Sui Stack Messaging) ----
# OPTIONAL on testnet: defaults to the deployed relayer
# (https://sui-stack-messaging.onrender.com), so real E2E messaging works with
# no env config. Set this only to override — e.g. a local relayer during
# development. NEXT_PUBLIC_* vars are baked into the client bundle at BUILD
# time — after changing this in Vercel you must trigger a fresh build.
# NEXT_PUBLIC_MESSAGING_RELAYER_URL=http://localhost:3002

# ---- Cash-out to naira (SERVER-SIDE: no NEXT_PUBLIC_ prefix, never in the browser) ----
# Optional. Adds "Cash out" to /wallet through Linq's offramp API. See DEPLOY.md.
# Rehearsal (no Linq, no bank is paid):
# CASHOUT_MODE=mock
# CASHOUT_MOCK_DEPOSIT_ADDRESS=0x...   # an address you control
# On mainnet a rehearsal sends REAL dollars to that address, so it is open only
# to the wallets you name here (comma-separated). Not needed on testnet.
# CASHOUT_MOCK_ALLOWED_OWNERS=0x...
# Live (real money; needs NEXT_PUBLIC_SUI_NETWORK=mainnet):
# LINQ_API_KEY=biz_live_...
# LINQ_WEBHOOK_SECRET=whsec_...
# Both modes on Vercel: Postgres for the order table (created on first use).
# DATABASE_URL=postgresql://...
# Per-order limits in dollars (defaults 1 and 500).
# CASHOUT_MIN_USD=1
# CASHOUT_MAX_USD=500
