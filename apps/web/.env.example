# ReeF web (Next.js) — environment.
# Copy to `.env.local` for local dev; set the SAME keys in the Vercel project
# (Project → Settings → Environment Variables). Every var here is NEXT_PUBLIC_*
# and therefore exposed to the browser — never put a private/secret key here.
# The social app is TESTNET ONLY in Phase 1. Only the wallet (below) can point
# at mainnet.

# ---- Sui network (social app) ----
NEXT_PUBLIC_SUI_NETWORK=testnet

# ---- Wallet: balances, sending, cash-out (/wallet) ----
# Which network the in-app wallet runs on. Leave it unset to ship without a
# wallet. It is independent of NEXT_PUBLIC_SUI_NETWORK: a zkLogin address is the
# same on both networks, so it is still the user's own account.
#   testnet  rehearse with free test USDC (https://faucet.circle.com, Sui Testnet)
#   mainnet  real money. First enable Mainnet for the Enoki PUBLIC key in the
#            Enoki portal; until then users can receive but Send stays off.
# USDC and USDSUI are sent with Sui's gasless stablecoin transfers, so users
# need no SUI and there is no sponsor to fund.
# NEXT_PUBLIC_WALLET_NETWORK=testnet

# ---- Published Move package (packages/move/deployments/testnet.json) ----
NEXT_PUBLIC_UMBRA_PACKAGE_ID=0x0
NEXT_PUBLIC_UMBRA_REGISTRY_ID=0x0

# ---- Enoki zkLogin (PUBLIC key only) + Google OAuth client ----
# The PRIVATE Enoki key lives on the indexer/sponsor service, never here.
# Add your Vercel domain to the Enoki allowed origins and the Google OAuth
# "Authorized JavaScript origins" or sign-in will be rejected.
NEXT_PUBLIC_ENOKI_PUBLIC_API_KEY=enoki_public_xxx
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ---- Deployed indexer (tRPC API + Enoki sponsor + image/DeepBook proxies) ----
# Local dev default is http://localhost:3001. In production point these at the
# indexer service you deploy separately (Railway / Render / Fly — see DEPLOY.md).
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
NEXT_PUBLIC_SPONSOR_API_URL=http://localhost:3001/sponsor
# "enoki" (default) or "self" (indexer's self-run sponsor, needs SPONSOR_SECRET_KEY there)
NEXT_PUBLIC_SPONSOR_MODE=enoki

# ---- Messaging relayer (Sui Stack Messaging) ----
# OPTIONAL on testnet: defaults to the deployed relayer
# (https://sui-stack-messaging.onrender.com), so real E2E messaging works with
# no env config. Set this only to override — e.g. a local relayer during
# development. NEXT_PUBLIC_* vars are baked into the client bundle at BUILD
# time — after changing this in Vercel you must trigger a fresh build.
# NEXT_PUBLIC_MESSAGING_RELAYER_URL=http://localhost:3002
