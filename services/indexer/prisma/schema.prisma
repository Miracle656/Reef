// Umbra indexer — Postgres schema. The chain is canonical; these tables are a
// materialized, queryable projection built from package events.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Per-module ingestion cursor (event pagination is per MoveModule filter).
model IngestCursor {
  module    String  @id // "profile" | "post" | "follow"
  txDigest  String
  eventSeq  String
  updatedAt DateTime @updatedAt
}

model Profile {
  id             String  @id // Sui object id
  owner          String  @unique
  handle         String  @unique
  displayName    String
  bio            String  @default("")
  avatarBlobId   String?
  suinsName      String?
  createdAtMs    BigInt
  updatedAtMs    BigInt

  @@index([handle])
}

model Post {
  id          String   @id // Sui object id
  author      String
  text        String
  media       String[] // Walrus blob ids
  replyTo     String?
  createdAtMs BigInt
  updatedAtMs BigInt
  deleted     Boolean  @default(false)

  @@index([author, createdAtMs])
  @@index([replyTo])
}

model Follow {
  follower    String
  followee    String
  createdAtMs BigInt

  @@id([follower, followee])
  @@index([followee])
  @@index([follower])
}

/// Verified external wallets linked to a zkLogin social account (the external
/// wallet signed the link). Farcaster-style "verified addresses".
model LinkedAddress {
  owner       String // zkLogin / social address
  linked      String // external wallet (the signer)
  createdAtMs BigInt

  @@id([owner, linked])
  @@index([owner])
  @@index([linked])
}

/// Creator coins — a tokenized post's Coin<T> + its DeepBook pool, owned by the
/// creator. Populated by the tokenize/mint flow (seeded for the demo).
model CreatorCoin {
  coinType    String  @id
  owner       String
  symbol      String
  name        String
  poolId      String?
  postId      String?
  createdAtMs BigInt

  @@index([owner])
}

/// Off-chain signed reactions, verified then aggregated (latest intent wins).
model Reaction {
  postId    String
  reactor   String
  kind      String // "like" | "repost"
  value     Int // 1 = active, 0 = removed
  timestamp BigInt

  @@id([postId, reactor, kind])
  @@index([postId, kind, value])
}

/// Stories / status — 24h ephemeral broadcast posts. Signature-verified on
/// write (the owner signs a canonical status message); pruned opportunistically.
model Status {
  id          String   @id @default(cuid())
  owner       String
  type        String // "text" | "image"
  content     String   @default("")
  mediaBlobId String? // public Walrus blob (unlike chat media, stories aren't E2E)
  bg          String?
  createdAtMs BigInt
  viewedBy    String[] @default([])

  @@index([owner, createdAtMs])
  @@index([createdAtMs])
}

/// Naira cash-outs through Linq (CLAUDE.md D-14): one row per order ReeF's server
/// created. Read and written by the web app's server routes with plain SQL
/// (`@umbra/core/server` `cashout/store`), never by the indexer. It is declared
/// here so `prisma db push` knows the table and keeps it.
model CashoutOrder {
  id                  String  @id // chosen by the client (uuid); also Linq's idempotency key
  owner               String // wallet address that made and funds the order
  network             String // wallet network the deposit is on
  linqOrderId         String  @unique
  coin                String // "usdc" | "usdsui"
  coinType            String
  depositAddress      String
  amountStable        BigInt // dollars to send, in the coin's base units
  amountNgn           String // naira to be paid out, e.g. "82750.00"
  rate                String // naira per dollar, locked when the order was made
  bankCode            String
  bankName            String
  accountName         String
  accountNumberMasked String // "******7890": the full number stays with Linq
  status              String // awaiting_deposit | processing | paid | failed | expired
  linqStatus          String // Linq's own status text, as last seen
  depositDigest       String?
  depositAtMs         BigInt?
  settledStable       BigInt?
  settledNgn          String?
  createdAtMs         BigInt
  expiresAtMs         BigInt
  updatedAtMs         BigInt
  refreshedAtMs       BigInt

  @@index([owner, createdAtMs])
}
